{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "/var/www/sites/main": "${workspaceFolder}/src/sites/main/php",
                "/var/www/sites/admin": "${workspaceFolder}/src/sites/admin/php",
                "/var/www/shared": "${workspaceFolder}/src/shared/php"
            }
        }
    ]
}
